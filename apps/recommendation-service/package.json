{
  "name": "@org/recommendation-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "recommendation-service",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/recommendation-service/dist/package.json",
          "{workspaceRoot}/apps/recommendation-service/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/recommendation-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "recommendation-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "recommendation-service:build:development"
          },
          "production": {
            "buildTarget": "recommendation-service:build:production"
          }
        }
      }
    },
    "tags": [
      "scope:recommendation"
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
