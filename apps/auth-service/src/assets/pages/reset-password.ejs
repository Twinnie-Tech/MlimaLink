<%
  const seller = Boolean(locals.seller);
  const eyebrow = locals.eyebrow || 'MlimaLink · Password reset';
  const resetUrl = locals.resetUrl || '/api/auth/reset-password';
-%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      <%= seller ? 'Reset Seller Password · MlimaLink Seller Centre' : 'Reset Password · MlimaLink' %>
    </title>
    <style>
      * {
        box-sizing: border-box;
      }
      :root {
        --page-bg: #f6efe9;
        --text: #2b1a12;
        --card-border: #ead8cb;
        --header-bg: linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #c2410c 100%);
        --eyebrow: #fed7aa;
        --input-border: #d9c3b4;
        --accent: #c2410c;
        --accent-bg: #c2410c;
        --focus-ring: rgba(194, 65, 12, 0.15);
        --muted: #8a6a5a;
        --body-text: #5c4033;
      }
      body.seller {
        --page-bg: #f0f0fa;
        --text: #1f1b3a;
        --card-border: #dcdcf2;
        --header-bg: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --eyebrow: #e4e0ff;
        --input-border: #cfcbe6;
        --accent: #5a4fcf;
        --accent-bg: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --focus-ring: rgba(102, 126, 234, 0.2);
        --muted: #7a7596;
        --body-text: #4a4566;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background-color: var(--page-bg);
        font-family: Arial, Helvetica, sans-serif;
        color: var(--text);
      }
      .card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border: 1px solid var(--card-border);
        border-radius: 12px;
        overflow: hidden;
      }
      .header {
        background: var(--header-bg);
        padding: 24px 28px;
        color: #ffffff;
      }
      .eyebrow {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--eyebrow);
      }
      .account {
        margin: 0 0 20px;
        padding: 10px 14px;
        border-radius: 8px;
        background: #f4f1fe;
        border: 1px solid #d6cdf6;
        font-size: 13px;
        line-height: 1.5;
        color: var(--body-text);
      }
      h1 {
        margin: 8px 0 0;
        font-family: Georgia, 'Times New Roman', Times, serif;
        font-size: 24px;
        font-weight: normal;
      }
      form {
        padding: 28px;
      }
      label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: bold;
      }
      .field {
        position: relative;
        margin-bottom: 18px;
      }
      .field input {
        width: 100%;
        padding: 12px 48px 12px 14px;
        border: 1px solid var(--input-border);
        border-radius: 8px;
        font-size: 15px;
      }
      .field input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--focus-ring);
      }
      .field button.toggle {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 46px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0 8px 8px 0;
        background: transparent;
        color: var(--muted);
      }
      .field button.toggle:hover,
      .field button.toggle:focus-visible {
        color: var(--text);
      }
      .field button.toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
      .toggle .icon-hide {
        display: none;
      }
      .toggle[aria-pressed='true'] .icon-show {
        display: none;
      }
      .toggle[aria-pressed='true'] .icon-hide {
        display: block;
      }
      .message a,
      .expired a.button {
        font-weight: bold;
        color: inherit;
      }
      .expired a.button {
        display: block;
        margin-top: 18px;
        padding: 13px;
        border-radius: 8px;
        background: var(--accent-bg);
        color: #ffffff;
        text-align: center;
        text-decoration: none;
      }
      .rules {
        margin: -8px 0 20px;
        font-size: 12px;
        line-height: 1.5;
        color: var(--muted);
      }
      button {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 8px;
        background: var(--accent-bg);
        color: #ffffff;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
      }
      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .message {
        display: none;
        margin-top: 18px;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 14px;
      }
      .message.error {
        display: block;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
      }
      .message.success {
        display: block;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
      }
      .expired {
        padding: 28px;
      }
      .expired p {
        margin: 0 0 12px;
        font-size: 15px;
        line-height: 1.6;
        color: var(--body-text);
      }
      .expired .notice {
        padding: 12px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 14px;
      }
    </style>
  </head>
  <body class="<%= seller ? 'seller' : '' %>">
    <div class="card">
      <div class="header">
        <p class="eyebrow"><%= eyebrow %></p>
        <h1>
          <%= tokenValid
            ? (seller ? 'Choose a new seller password' : 'Choose a new password')
            : 'Link expired' %>
        </h1>
      </div>

      <% if (tokenValid) { %>
      <form
        id="reset-form"
        data-login-url="<%= loginUrl %>"
        data-reset-url="<%= resetUrl %>"
        novalidate
      >
        <input type="hidden" id="token" value="<%= token %>" />
        <% if (seller) { %>
        <p class="account">
          This changes the password for your <strong>seller business
          account</strong> only. Your shop will be signed out of every device.
        </p>
        <% } %>

        <% ['password', 'confirmPassword'].forEach(function (id) { %>
        <label for="<%= id %>">
          <%= id === 'password' ? 'New password' : 'Confirm new password' %>
        </label>
        <div class="field">
          <input
            type="password"
            id="<%= id %>"
            autocomplete="new-password"
            required
          />
          <button
            type="button"
            class="toggle"
            data-target="<%= id %>"
            aria-controls="<%= id %>"
            aria-pressed="false"
            aria-label="Show password"
          >
            <svg class="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
              <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
              <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
              <path d="m2 2 20 20" />
            </svg>
          </button>
        </div>
        <% if (id === 'password') { %>
        <p class="rules">
          At least 8 characters with uppercase, lowercase, a number, and a
          special character.
        </p>
        <% } %>
        <% }); %>

        <button type="submit" id="submit">Update password</button>
        <div id="message" class="message" role="alert"></div>
      </form>
      <% } else { %>
      <div class="expired">
        <p class="notice" role="alert">
          This password reset link is invalid, has expired, or has already been
          used.
        </p>
        <p>
          Reset links are valid for 15 minutes and can only be used once.
          Please request a new link from the forgot password page.
        </p>
        <a class="button" href="<%= forgotPasswordUrl %>">Request a new link</a>
      </div>
      <% } %>
    </div>

    <% if (tokenValid) { %>
    <script>
      (function () {
        var form = document.getElementById('reset-form');
        var token = document.getElementById('token').value;
        var passwordInput = document.getElementById('password');
        var confirmInput = document.getElementById('confirmPassword');
        var submit = document.getElementById('submit');
        var message = document.getElementById('message');
        var loginUrl = form.dataset.loginUrl;
        var resetUrl = form.dataset.resetUrl;
        var REDIRECT_SECONDS = 3;
        var passwordRegex =
          /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/;

        function show(text, type) {
          message.textContent = text;
          message.className = 'message ' + type;
        }

        document.querySelectorAll('.toggle').forEach(function (toggle) {
          var input = document.getElementById(toggle.dataset.target);
          toggle.addEventListener('click', function () {
            var visible = input.type === 'password';
            input.type = visible ? 'text' : 'password';
            toggle.setAttribute('aria-pressed', String(visible));
            toggle.setAttribute(
              'aria-label',
              visible ? 'Hide password' : 'Show password',
            );
          });
        });

        function redirectToLogin(text) {
          var secondsLeft = REDIRECT_SECONDS;
          var countdown = document.createElement('span');
          var link = document.createElement('a');
          link.href = loginUrl;
          link.textContent = 'Go to login now';

          function render() {
            countdown.textContent =
              ' Redirecting to login in ' + secondsLeft + 's… ';
          }

          show(text, 'success');
          render();
          message.appendChild(countdown);
          message.appendChild(link);

          var timer = setInterval(function () {
            secondsLeft -= 1;
            if (secondsLeft <= 0) {
              clearInterval(timer);
              window.location.assign(loginUrl);
              return;
            }
            render();
          }, 1000);
        }

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          var password = passwordInput.value;
          var confirmPassword = confirmInput.value;

          if (password !== confirmPassword) {
            show('Passwords do not match.', 'error');
            return;
          }

          if (!passwordRegex.test(password)) {
            show(
              'Password must be at least 8 characters and include uppercase, lowercase, a number, and a special character.',
              'error',
            );
            return;
          }

          submit.disabled = true;
          submit.textContent = 'Updating…';

          try {
            var response = await fetch(resetUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: token,
                password: password,
                confirmPassword: confirmPassword,
              }),
            });
            var body = await response.json().catch(function () {
              return {};
            });

            if (!response.ok) {
              show(body.error || 'Could not reset your password.', 'error');
              submit.disabled = false;
              submit.textContent = 'Update password';
              return;
            }

            form.reset();
            submit.textContent = 'Password updated';
            redirectToLogin(body.message || 'Password updated.');
          } catch (error) {
            show('Network error. Please try again.', 'error');
            submit.disabled = false;
            submit.textContent = 'Update password';
          }
        });
      })();
    </script>
    <% } %>
  </body>
</html>
