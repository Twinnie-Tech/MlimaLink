<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password · MlimaLink</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background-color: #f6efe9;
        font-family: Arial, Helvetica, sans-serif;
        color: #2b1a12;
      }
      .card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border: 1px solid #ead8cb;
        border-radius: 12px;
        overflow: hidden;
      }
      .header {
        background: linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #c2410c 100%);
        padding: 24px 28px;
        color: #ffffff;
      }
      .eyebrow {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #fed7aa;
      }
      h1 {
        margin: 8px 0 0;
        font-family: Georgia, 'Times New Roman', Times, serif;
        font-size: 24px;
        font-weight: normal;
      }
      form {
        padding: 28px;
      }
      label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: bold;
      }
      .field {
        position: relative;
        margin-bottom: 18px;
      }
      .field input {
        width: 100%;
        padding: 12px 48px 12px 14px;
        border: 1px solid #d9c3b4;
        border-radius: 8px;
        font-size: 15px;
      }
      .field input:focus {
        outline: none;
        border-color: #c2410c;
        box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.15);
      }
      .field button.toggle {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 46px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0 8px 8px 0;
        background: transparent;
        color: #8a6a5a;
      }
      .field button.toggle:hover,
      .field button.toggle:focus-visible {
        color: #2b1a12;
      }
      .field button.toggle:focus-visible {
        outline: 2px solid #c2410c;
        outline-offset: -2px;
      }
      .toggle .icon-hide {
        display: none;
      }
      .toggle[aria-pressed='true'] .icon-show {
        display: none;
      }
      .toggle[aria-pressed='true'] .icon-hide {
        display: block;
      }
      .message a,
      .expired a.button {
        font-weight: bold;
        color: inherit;
      }
      .expired a.button {
        display: block;
        margin-top: 18px;
        padding: 13px;
        border-radius: 8px;
        background-color: #c2410c;
        color: #ffffff;
        text-align: center;
        text-decoration: none;
      }
      .rules {
        margin: -8px 0 20px;
        font-size: 12px;
        line-height: 1.5;
        color: #8a6a5a;
      }
      button {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 8px;
        background-color: #c2410c;
        color: #ffffff;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
      }
      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .message {
        display: none;
        margin-top: 18px;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 14px;
      }
      .message.error {
        display: block;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
      }
      .message.success {
        display: block;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
      }
      .expired {
        padding: 28px;
      }
      .expired p {
        margin: 0 0 12px;
        font-size: 15px;
        line-height: 1.6;
        color: #5c4033;
      }
      .expired .notice {
        padding: 12px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="header">
        <p class="eyebrow">MlimaLink · Password reset</p>
        <h1><%= tokenValid ? 'Choose a new password' : 'Link expired' %></h1>
      </div>

      <% if (tokenValid) { %>
      <form id="reset-form" data-login-url="<%= loginUrl %>" novalidate>
        <input type="hidden" id="token" value="<%= token %>" />

        <% ['password', 'confirmPassword'].forEach(function (id) { %>
        <label for="<%= id %>">
          <%= id === 'password' ? 'New password' : 'Confirm new password' %>
        </label>
        <div class="field">
          <input
            type="password"
            id="<%= id %>"
            autocomplete="new-password"
            required
          />
          <button
            type="button"
            class="toggle"
            data-target="<%= id %>"
            aria-controls="<%= id %>"
            aria-pressed="false"
            aria-label="Show password"
          >
            <svg class="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
              <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
              <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
              <path d="m2 2 20 20" />
            </svg>
          </button>
        </div>
        <% if (id === 'password') { %>
        <p class="rules">
          At least 8 characters with uppercase, lowercase, a number, and a
          special character.
        </p>
        <% } %>
        <% }); %>

        <button type="submit" id="submit">Update password</button>
        <div id="message" class="message" role="alert"></div>
      </form>
      <% } else { %>
      <div class="expired">
        <p class="notice" role="alert">
          This password reset link is invalid, has expired, or has already been
          used.
        </p>
        <p>
          Reset links are valid for 15 minutes and can only be used once.
          Please request a new link from the forgot password page.
        </p>
        <a class="button" href="<%= forgotPasswordUrl %>">Request a new link</a>
      </div>
      <% } %>
    </div>

    <% if (tokenValid) { %>
    <script>
      (function () {
        var form = document.getElementById('reset-form');
        var token = document.getElementById('token').value;
        var passwordInput = document.getElementById('password');
        var confirmInput = document.getElementById('confirmPassword');
        var submit = document.getElementById('submit');
        var message = document.getElementById('message');
        var loginUrl = form.dataset.loginUrl;
        var REDIRECT_SECONDS = 3;
        var passwordRegex =
          /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/;

        function show(text, type) {
          message.textContent = text;
          message.className = 'message ' + type;
        }

        document.querySelectorAll('.toggle').forEach(function (toggle) {
          var input = document.getElementById(toggle.dataset.target);
          toggle.addEventListener('click', function () {
            var visible = input.type === 'password';
            input.type = visible ? 'text' : 'password';
            toggle.setAttribute('aria-pressed', String(visible));
            toggle.setAttribute(
              'aria-label',
              visible ? 'Hide password' : 'Show password',
            );
          });
        });

        function redirectToLogin(text) {
          var secondsLeft = REDIRECT_SECONDS;
          var countdown = document.createElement('span');
          var link = document.createElement('a');
          link.href = loginUrl;
          link.textContent = 'Go to login now';

          function render() {
            countdown.textContent =
              ' Redirecting to login in ' + secondsLeft + 's… ';
          }

          show(text, 'success');
          render();
          message.appendChild(countdown);
          message.appendChild(link);

          var timer = setInterval(function () {
            secondsLeft -= 1;
            if (secondsLeft <= 0) {
              clearInterval(timer);
              window.location.assign(loginUrl);
              return;
            }
            render();
          }, 1000);
        }

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          var password = passwordInput.value;
          var confirmPassword = confirmInput.value;

          if (password !== confirmPassword) {
            show('Passwords do not match.', 'error');
            return;
          }

          if (!passwordRegex.test(password)) {
            show(
              'Password must be at least 8 characters and include uppercase, lowercase, a number, and a special character.',
              'error',
            );
            return;
          }

          submit.disabled = true;
          submit.textContent = 'Updating…';

          try {
            var response = await fetch('/api/auth/reset-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: token,
                password: password,
                confirmPassword: confirmPassword,
              }),
            });
            var body = await response.json().catch(function () {
              return {};
            });

            if (!response.ok) {
              show(body.error || 'Could not reset your password.', 'error');
              submit.disabled = false;
              submit.textContent = 'Update password';
              return;
            }

            form.reset();
            submit.textContent = 'Password updated';
            redirectToLogin(body.message || 'Password updated.');
          } catch (error) {
            show('Network error. Please try again.', 'error');
            submit.disabled = false;
            submit.textContent = 'Update password';
          }
        });
      })();
    </script>
    <% } %>
  </body>
</html>
