<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password · MlimaLink</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background-color: #f6efe9;
        font-family: Arial, Helvetica, sans-serif;
        color: #2b1a12;
      }
      .card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border: 1px solid #ead8cb;
        border-radius: 12px;
        overflow: hidden;
      }
      .header {
        background: linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #c2410c 100%);
        padding: 24px 28px;
        color: #ffffff;
      }
      .eyebrow {
        margin: 0;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #fed7aa;
      }
      h1 {
        margin: 8px 0 0;
        font-family: Georgia, 'Times New Roman', Times, serif;
        font-size: 24px;
        font-weight: normal;
      }
      form {
        padding: 28px;
      }
      label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: bold;
      }
      input[type='password'] {
        width: 100%;
        padding: 12px 14px;
        margin-bottom: 18px;
        border: 1px solid #d9c3b4;
        border-radius: 8px;
        font-size: 15px;
      }
      input[type='password']:focus {
        outline: none;
        border-color: #c2410c;
        box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.15);
      }
      .rules {
        margin: -8px 0 20px;
        font-size: 12px;
        line-height: 1.5;
        color: #8a6a5a;
      }
      button {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 8px;
        background-color: #c2410c;
        color: #ffffff;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
      }
      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .message {
        display: none;
        margin-top: 18px;
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 14px;
      }
      .message.error {
        display: block;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
      }
      .message.success {
        display: block;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
      }
      .expired {
        padding: 28px;
      }
      .expired p {
        margin: 0 0 12px;
        font-size: 15px;
        line-height: 1.6;
        color: #5c4033;
      }
      .expired .notice {
        padding: 12px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="header">
        <p class="eyebrow">MlimaLink · Password reset</p>
        <h1><%= tokenValid ? 'Choose a new password' : 'Link expired' %></h1>
      </div>

      <% if (tokenValid) { %>
      <form id="reset-form" novalidate>
        <input type="hidden" id="token" value="<%= token %>" />

        <label for="password">New password</label>
        <input
          type="password"
          id="password"
          autocomplete="new-password"
          required
        />
        <p class="rules">
          At least 8 characters with uppercase, lowercase, a number, and a
          special character.
        </p>

        <label for="confirmPassword">Confirm new password</label>
        <input
          type="password"
          id="confirmPassword"
          autocomplete="new-password"
          required
        />

        <button type="submit" id="submit">Update password</button>
        <div id="message" class="message" role="alert"></div>
      </form>
      <% } else { %>
      <div class="expired">
        <p class="notice" role="alert">
          This password reset link is invalid, has expired, or has already been
          used.
        </p>
        <p>
          Reset links are valid for 15 minutes and can only be used once.
          Please request a new link from the forgot password page.
        </p>
      </div>
      <% } %>
    </div>

    <% if (tokenValid) { %>
    <script>
      (function () {
        var form = document.getElementById('reset-form');
        var token = document.getElementById('token').value;
        var passwordInput = document.getElementById('password');
        var confirmInput = document.getElementById('confirmPassword');
        var submit = document.getElementById('submit');
        var message = document.getElementById('message');
        var passwordRegex =
          /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/;

        function show(text, type) {
          message.textContent = text;
          message.className = 'message ' + type;
        }

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          var password = passwordInput.value;
          var confirmPassword = confirmInput.value;

          if (password !== confirmPassword) {
            show('Passwords do not match.', 'error');
            return;
          }

          if (!passwordRegex.test(password)) {
            show(
              'Password must be at least 8 characters and include uppercase, lowercase, a number, and a special character.',
              'error',
            );
            return;
          }

          submit.disabled = true;
          submit.textContent = 'Updating…';

          try {
            var response = await fetch('/api/auth/reset-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                token: token,
                password: password,
                confirmPassword: confirmPassword,
              }),
            });
            var body = await response.json().catch(function () {
              return {};
            });

            if (!response.ok) {
              show(body.error || 'Could not reset your password.', 'error');
              submit.disabled = false;
              submit.textContent = 'Update password';
              return;
            }

            form.reset();
            show(body.message || 'Password updated. You can now log in.', 'success');
            submit.textContent = 'Password updated';
          } catch (error) {
            show('Network error. Please try again.', 'error');
            submit.disabled = false;
            submit.textContent = 'Update password';
          }
        });
      })();
    </script>
    <% } %>
  </body>
</html>
