<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Verify your seller account</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f0f0fa;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #1f1b3a;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f0f0fa; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #dcdcf2;
            "
          >
            <!-- Header — seller brand (indigo to purple), distinct from the green shopper OTP -->
            <tr>
              <td
                style="
                  background-color: #5a4fcf;
                  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #e4e0ff;
                  "
                >
                  MlimaLink Seller Centre &nbsp;·&nbsp; Business account
                </p>
                <h1
                  style="
                    margin: 8px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    line-height: 1.3;
                    color: #ffffff;
                  "
                >
                  Verify your seller account
                </h1>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 32px">
                <p
                  style="
                    margin: 0 0 16px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    font-weight: bold;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                  "
                >
                  <span
                    style="
                      display: inline-block;
                      padding: 5px 10px;
                      border-radius: 999px;
                      background-color: #efeafd;
                      color: #5b3f99;
                    "
                  >
                    Seller business account
                  </span>
                </p>
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #1f1b3a;
                  "
                >
                  Hello <strong style="color: #5b3f99"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 24px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #4a4566;
                  "
                >
                  You&rsquo;re opening a <strong>seller account</strong> on
                  MlimaLink so your business can sell to shoppers across the
                  marketplace. Enter the code below to verify your email and
                  continue to setting up your shop.
                </p>

                <!-- OTP card -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f7f6fe;
                    border: 1px dashed #c3bdf0;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 20px 24px; text-align: center">
                      <p
                        style="
                          margin: 0 0 8px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          letter-spacing: 0.14em;
                          text-transform: uppercase;
                          color: #6e6893;
                        "
                      >
                        Seller verification code
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: 'Courier New', Courier, monospace;
                          font-size: 36px;
                          font-weight: bold;
                          letter-spacing: 10px;
                          color: #5b3f99;
                        "
                      >
                        <%= otp %>
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Next steps -->
                <p
                  style="
                    margin: 24px 0 8px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    font-weight: bold;
                    color: #1f1b3a;
                  "
                >
                  What happens next
                </p>
                <ol
                  style="
                    margin: 0;
                    padding-left: 20px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    line-height: 1.7;
                    color: #4a4566;
                  "
                >
                  <li>Verify your email with this code</li>
                  <li>Set up your shop: name, category, address and hours</li>
                  <li>Connect your bank through Stripe to get paid</li>
                </ol>

                <p
                  style="
                    margin: 24px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #4a4566;
                  "
                >
                  This code expires in
                  <strong style="color: #c47b16">24 hours</strong>.
                </p>
                <p
                  style="
                    margin: 12px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 13px;
                    line-height: 1.6;
                    color: #7a7596;
                  "
                >
                  If you did not start a seller account, you can safely ignore
                  this email.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f6f5fd;
                  border-top: 1px solid #dcdcf2;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #7a7596;
                  "
                >
                  &copy; MlimaLink Seller Centre &mdash; helping growers sell to
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
