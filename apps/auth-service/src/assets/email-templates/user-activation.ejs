<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Email Verification</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #eef3ef;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #1a2e22;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #eef3ef; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #d5e3d9;
            "
          >
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0b6e4f 0%, #147a56 55%, #1b8a61 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 13px;
                    letter-spacing: 0.12em;
                    text-transform: uppercase;
                    color: #c8f0dc;
                  "
                >
                  MlimaLink &nbsp;·&nbsp; OTP verification
                </p>
                <h1
                  style="
                    margin: 8px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    color: #ffffff;
                  "
                >
                  Verify your email
                </h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 32px">
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    color: #1a2e22;
                  "
                >
                  Hello <strong style="color: #0b6e4f"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 24px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #3d5348;
                  "
                >
                  Use the one-time password below to verify your email address.
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f7fbf8;
                    border: 1px dashed #b7d4c3;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 20px 24px; text-align: center">
                      <p
                        style="
                          margin: 0 0 8px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          letter-spacing: 0.14em;
                          text-transform: uppercase;
                          color: #5f7a6c;
                        "
                      >
                        Your verification code
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: 'Courier New', Courier, monospace;
                          font-size: 36px;
                          font-weight: bold;
                          letter-spacing: 10px;
                          color: #0b6e4f;
                        "
                      >
                        <%= otp %>
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 24px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    color: #3d5348;
                  "
                >
                  This code expires in
                  <strong style="color: #c47b16">24 hours</strong>.
                </p>
                <p
                  style="
                    margin: 12px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 13px;
                    color: #6b8175;
                  "
                >
                  If you did not request this, you can safely ignore this email.
                </p>
              </td>
            </tr>

            <tr>
              <td
                style="
                  background-color: #f3f8f5;
                  border-top: 1px solid #d5e3d9;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #6b8175;
                  "
                >
                  &copy; MlimaLink Marketplace &mdash; connecting growers and
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
