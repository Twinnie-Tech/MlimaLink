<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Account Created</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #e8eef5;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #0f1c2e;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #e8eef5; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #c5d4e8;
            "
          >
            <!-- Header — navy (distinct from green OTP emails) -->
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0a2540 0%, #123a66 50%, #1a508a 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #9ec5f0;
                  "
                >
                  MlimaLink &nbsp;·&nbsp; Account confirmed
                </p>
                <h1
                  style="
                    margin: 10px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    line-height: 1.3;
                    color: #ffffff;
                  "
                >
                  You&rsquo;re all set
                </h1>
              </td>
            </tr>

            <!-- Success banner -->
            <tr>
              <td style="padding: 0 32px">
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 28px;
                    background-color: #eef6ff;
                    border: 1px solid #b8d4f0;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 18px 20px; text-align: center">
                      <p
                        style="
                          margin: 0 0 6px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 13px;
                          letter-spacing: 0.1em;
                          text-transform: uppercase;
                          color: #3d6ea5;
                        "
                      >
                        Registration complete
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 18px;
                          font-weight: bold;
                          color: #0a2540;
                        "
                      >
                        Your MlimaLink account is ready
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 28px 32px 32px">
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #0f1c2e;
                  "
                >
                  Hello <strong style="color: #123a66"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 20px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #3d4f66;
                  "
                >
                  Great news — your email has been verified and your account
                  has been created successfully. You can now sign in and start
                  exploring the marketplace.
                </p>

                <!-- Account details card -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f5f8fc;
                    border: 1px solid #d0ddee;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 18px 22px">
                      <p
                        style="
                          margin: 0 0 12px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          letter-spacing: 0.12em;
                          text-transform: uppercase;
                          color: #5a7394;
                        "
                      >
                        Account details
                      </p>
                      <p
                        style="
                          margin: 0 0 8px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          color: #3d4f66;
                        "
                      >
                        <strong style="color: #0a2540">Name:</strong>
                        <%= name %>
                      </p>
                      <p
                        style="
                          margin: 0 0 8px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          color: #3d4f66;
                        "
                      >
                        <strong style="color: #0a2540">Email:</strong>
                        <%= email %>
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          color: #3d4f66;
                        "
                      >
                        <strong style="color: #0a2540">Role:</strong>
                        <%= role || 'user' %>
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 22px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #3d4f66;
                  "
                >
                  If you did not create this account, contact our support team
                  right away.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f0f5fb;
                  border-top: 1px solid #c5d4e8;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #5a7394;
                  "
                >
                  &copy; MlimaLink Marketplace &mdash; connecting growers and
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
