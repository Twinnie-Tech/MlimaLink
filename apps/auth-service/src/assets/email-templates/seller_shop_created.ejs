<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Your seller business account is ready</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f0f0fa;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #1f1b3a;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f0f0fa; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #dcdcf2;
            "
          >
            <!-- Header — seller brand -->
            <tr>
              <td
                style="
                  background-color: #5a4fcf;
                  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #e4e0ff;
                  "
                >
                  MlimaLink Seller Centre &nbsp;·&nbsp; Shop created
                </p>
                <h1
                  style="
                    margin: 8px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    line-height: 1.3;
                    color: #ffffff;
                  "
                >
                  Your shop is open for business
                </h1>
              </td>
            </tr>

            <!-- Success banner -->
            <tr>
              <td style="padding: 0 32px">
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 28px;
                    background-color: #f4f1fe;
                    border: 1px solid #d6cdf6;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 18px 20px; text-align: center">
                      <p
                        style="
                          margin: 0 0 6px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 13px;
                          letter-spacing: 0.1em;
                          text-transform: uppercase;
                          color: #6b52b0;
                        "
                      >
                        Seller business account
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 18px;
                          font-weight: bold;
                          color: #2b1f55;
                        "
                      >
                        <%= shopName %> is ready to start selling
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 28px 32px 32px">
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #1f1b3a;
                  "
                >
                  Hello <strong style="color: #5b3f99"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 20px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #4a4566;
                  "
                >
                  Congratulations &mdash; your seller business account is set
                  up. You can now start selling on MlimaLink by posting your
                  products. Every product you post appears on your shop page and
                  in the marketplace for shoppers to find and buy.
                </p>

                <!-- Shop details card -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: #f8f7fd;
                    border: 1px solid #e0dcf3;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 18px 22px">
                      <p
                        style="
                          margin: 0 0 12px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          letter-spacing: 0.12em;
                          text-transform: uppercase;
                          color: #6e6893;
                        "
                      >
                        Business details
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Shop:</strong>
                        <%= shopName %>
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Category:</strong>
                        <%= category %>
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Address:</strong>
                        <%= address %>
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Opening hours:</strong>
                        <% if (openingHours.length) { %>
                          <%= openingHours.join(' · ') %>
                        <% } else { %>
                          Not set yet
                        <% } %>
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Account email:</strong>
                        <%= email %>
                      </p>
                      <p style="margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Account type:</strong>
                        Seller business account
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Start selling -->
                <p
                  style="
                    margin: 24px 0 8px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    font-weight: bold;
                    color: #1f1b3a;
                  "
                >
                  Start selling in a few minutes
                </p>
                <ol
                  style="
                    margin: 0;
                    padding-left: 20px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    line-height: 1.7;
                    color: #4a4566;
                  "
                >
                  <li>
                    <strong>Post your products</strong> with clear photos, a
                    price and how many you have in stock.
                  </li>
                  <% if (!bankConnected) { %>
                  <li>
                    <strong>Connect your bank</strong> through Stripe so we can
                    pay out your sales.
                  </li>
                  <% } %>
                  <li>
                    <strong>Keep prices and stock up to date</strong> so buyers
                    can order with confidence.
                  </li>
                </ol>

                <!-- Call to action -->
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 26px auto 0"
                >
                  <tr>
                    <td
                      style="
                        border-radius: 8px;
                        background-color: #5a4fcf;
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                      "
                    >
                      <a
                        href="<%= dashboardUrl %>"
                        style="
                          display: inline-block;
                          padding: 13px 28px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          color: #ffffff;
                          text-decoration: none;
                        "
                      >
                        Start posting products
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 26px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 13px;
                    line-height: 1.6;
                    color: #7a7596;
                  "
                >
                  If you did not create this shop, contact our support team
                  right away.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f6f5fd;
                  border-top: 1px solid #dcdcf2;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #7a7596;
                  "
                >
                  &copy; MlimaLink Seller Centre &mdash; helping growers sell to
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
