<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Your password was changed</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f6efe9;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #2b1a12;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f6efe9; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #ead8cb;
            "
          >
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #c2410c 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #fed7aa;
                  "
                >
                  MlimaLink &nbsp;·&nbsp; Security notice
                </p>
                <h1
                  style="
                    margin: 10px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    line-height: 1.3;
                    color: #ffffff;
                  "
                >
                  Your password was changed
                </h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 32px">
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #2b1a12;
                  "
                >
                  Hello <strong style="color: #9a3412"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 20px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #5c4033;
                  "
                >
                  The password for your MlimaLink account
                  <strong style="color: #2b1a12"><%= email %></strong> was
                  changed successfully. For your security we signed you out on
                  every device, so log in again with your new password.
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-bottom: 28px;
                    background-color: #fdf6f1;
                    border: 1px solid #f1dfd2;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 14px 18px">
                      <p
                        style="
                          margin: 0 0 4px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          letter-spacing: 0.08em;
                          text-transform: uppercase;
                          color: #8a6a5a;
                        "
                      >
                        Changed on
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          color: #2b1a12;
                        "
                      >
                        <%= changedAt %>
                      </p>
                    </td>
                  </tr>
                </table>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  align="center"
                >
                  <tr>
                    <td
                      style="
                        border-radius: 8px;
                        background-color: #c2410c;
                        text-align: center;
                      "
                    >
                      <a
                        href="<%= loginUrl %>"
                        target="_blank"
                        style="
                          display: inline-block;
                          padding: 14px 32px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          color: #ffffff;
                          text-decoration: none;
                          border-radius: 8px;
                        "
                        >Log in to MlimaLink</a
                      >
                    </td>
                  </tr>
                </table>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 28px;
                    background-color: #fef2f2;
                    border: 1px solid #fecaca;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 14px 18px">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          line-height: 1.6;
                          color: #991b1b;
                        "
                      >
                        <strong>Didn't change your password?</strong> Someone
                        else may have access to your email. Secure your account
                        right away by
                        <a
                          href="<%= forgotPasswordUrl %>"
                          target="_blank"
                          style="color: #991b1b; font-weight: bold"
                          >resetting your password</a
                        >.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td
                style="
                  background-color: #fbf4ef;
                  border-top: 1px solid #ead8cb;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #8a6a5a;
                  "
                >
                  &copy; MlimaLink Marketplace &mdash; connecting growers and
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
