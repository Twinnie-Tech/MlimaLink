<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Your seller account password was changed</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f0f0fa;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #1f1b3a;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f0f0fa; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #dcdcf2;
            "
          >
            <!-- Header — seller brand -->
            <tr>
              <td
                style="
                  background-color: #5a4fcf;
                  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #e4e0ff;
                  "
                >
                  MlimaLink Seller Centre &nbsp;·&nbsp; Security notice
                </p>
                <h1
                  style="
                    margin: 8px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    line-height: 1.3;
                    color: #ffffff;
                  "
                >
                  Your seller account password was changed
                </h1>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 32px">
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #1f1b3a;
                  "
                >
                  Hello <strong style="color: #5b3f99"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 20px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #4a4566;
                  "
                >
                  The password for your MlimaLink seller account was changed
                  successfully. For your shop's security we signed you out of
                  the Seller Centre on every device, so log in again with your
                  new password.
                </p>

                <!-- Account details card -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-bottom: 28px;
                    background-color: #f8f7fd;
                    border: 1px solid #e0dcf3;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 18px 22px">
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Shop:</strong>
                        <% if (shopName) { %>
                          <%= shopName %>
                        <% } else { %>
                          Not set up yet
                        <% } %>
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Account email:</strong>
                        <%= email %>
                      </p>
                      <p style="margin: 0 0 8px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Account type:</strong>
                        Seller business account
                      </p>
                      <p style="margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #4a4566">
                        <strong style="color: #2b1f55">Changed on:</strong>
                        <%= changedAt %>
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Call to action -->
                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin: 0 auto"
                >
                  <tr>
                    <td
                      style="
                        border-radius: 8px;
                        background-color: #5a4fcf;
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                      "
                    >
                      <a
                        href="<%= loginUrl %>"
                        target="_blank"
                        style="
                          display: inline-block;
                          padding: 13px 28px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          color: #ffffff;
                          text-decoration: none;
                        "
                      >
                        Log in to Seller Centre
                      </a>
                    </td>
                  </tr>
                </table>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 28px;
                    background-color: #fef2f2;
                    border: 1px solid #fecaca;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 14px 18px">
                      <p
                        style="
                          margin: 0;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 14px;
                          line-height: 1.6;
                          color: #991b1b;
                        "
                      >
                        <strong>Didn't change your password?</strong> Someone
                        else may have access to your shop. Secure your seller
                        account right away by
                        <a
                          href="<%= forgotPasswordUrl %>"
                          target="_blank"
                          style="color: #991b1b; font-weight: bold"
                          >resetting your seller password</a
                        >.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f6f5fd;
                  border-top: 1px solid #dcdcf2;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #7a7596;
                  "
                >
                  &copy; MlimaLink Seller Centre &mdash; helping growers sell to
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
