<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Reset Your Password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f6efe9;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #2b1a12;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f6efe9; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              border: 1px solid #ead8cb;
            "
          >
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #7c2d12 0%, #9a3412 50%, #c2410c 100%);
                  padding: 28px 32px;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #fed7aa;
                  "
                >
                  MlimaLink &nbsp;·&nbsp; Password reset
                </p>
                <h1
                  style="
                    margin: 10px 0 0;
                    font-family: Georgia, 'Times New Roman', Times, serif;
                    font-size: 26px;
                    font-weight: normal;
                    line-height: 1.3;
                    color: #ffffff;
                  "
                >
                  Reset your password
                </h1>
              </td>
            </tr>

            <tr>
              <td style="padding: 32px">
                <p
                  style="
                    margin: 0 0 12px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #2b1a12;
                  "
                >
                  Hello <strong style="color: #9a3412"><%= name %></strong>,
                </p>
                <p
                  style="
                    margin: 0 0 28px;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 15px;
                    line-height: 1.65;
                    color: #5c4033;
                  "
                >
                  We received a request to reset the password for your
                  MlimaLink account. Click the button below to choose a new
                  password.
                </p>

                <table
                  role="presentation"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  align="center"
                >
                  <tr>
                    <td
                      style="
                        border-radius: 8px;
                        background-color: #c2410c;
                        text-align: center;
                      "
                    >
                      <a
                        href="<%= resetLink %>"
                        target="_blank"
                        style="
                          display: inline-block;
                          padding: 14px 32px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 15px;
                          font-weight: bold;
                          color: #ffffff;
                          text-decoration: none;
                          border-radius: 8px;
                        "
                        >Reset password</a
                      >
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 28px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #5c4033;
                  "
                >
                  This link expires in
                  <strong style="color: #9a3412"
                    ><%= expiresInMinutes %> minutes</strong
                  >
                  and can only be used once.
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    margin-top: 20px;
                    background-color: #fdf6f1;
                    border: 1px solid #f1dfd2;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td style="padding: 14px 18px">
                      <p
                        style="
                          margin: 0 0 6px;
                          font-family: Arial, Helvetica, sans-serif;
                          font-size: 12px;
                          color: #8a6a5a;
                        "
                      >
                        Button not working? Copy this link into your browser:
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-family: 'Courier New', Courier, monospace;
                          font-size: 12px;
                          word-break: break-all;
                          color: #9a3412;
                        "
                      >
                        <%= resetLink %>
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 20px 0 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 13px;
                    line-height: 1.6;
                    color: #8a6a5a;
                  "
                >
                  If you did not request a password reset, you can safely
                  ignore this email — your password will not change.
                </p>
              </td>
            </tr>

            <tr>
              <td
                style="
                  background-color: #fbf4ef;
                  border-top: 1px solid #ead8cb;
                  padding: 18px 32px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12px;
                    color: #8a6a5a;
                  "
                >
                  &copy; MlimaLink Marketplace &mdash; connecting growers and
                  buyers
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
