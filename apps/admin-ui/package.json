{
  "name": "@org/admin-ui",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/admin-ui/src",
    "tags": [
      "scope:admin"
    ],
    "targets": {
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "dev": {
        "options": {
          "port": 4400
        }
      },
      "start": {
        "options": {
          "port": 4400,
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "serve-static": {
        "options": {
          "port": 4400,
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@org/chat-ui": "*",
    "@org/models": "^0.0.1",
    "@tanstack/react-query": "^5.104.0",
    "cobe": "^2.0.1",
    "lucide-react": "^1.48.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
