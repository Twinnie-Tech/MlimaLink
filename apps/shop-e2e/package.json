{
  "name": "@org/shop-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@org/shop",
      "@org/api-gateway",
      "api"
    ],
    "targets": {
      "e2e": {
        "dependsOn": [
          "api:build",
          "@org/api-gateway:build",
          "@org/shop:build"
        ],
        "options": {
          "command": "node ../../tools/run-shop-e2e.mjs"
        }
      }
    }
  }
}
