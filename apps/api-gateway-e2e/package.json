{
  "name": "@org/api-gateway-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@org/api-gateway",
      "api"
    ],
    "targets": {
      "e2e": {
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "api:build",
          "@org/api-gateway:build"
        ],
        "options": {
          "command": "node ../../tools/run-api-gateway-e2e.mjs"
        }
      }
    }
  }
}
