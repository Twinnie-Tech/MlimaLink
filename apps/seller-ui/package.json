{
  "name": "@org/seller-ui",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/seller-ui/src",
    "tags": [
      "scope:seller"
    ],
    "targets": {
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "dev": {
        "options": {
          "port": 4300
        }
      },
      "start": {
        "options": {
          "port": 4300,
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "serve-static": {
        "options": {
          "port": 4300,
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@org/models": "^0.0.1",
    "@tanstack/react-query": "^5.104.0",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.48.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0"
  }
}
