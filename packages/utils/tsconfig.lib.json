{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "auth/**/*.ts",
    "events/**/*.ts",
    "kafka/**/*.ts",
    "logs/**/*.ts"
  ],
  "references": [],
  "exclude": ["vitest.config.mts", "**/*.spec.ts", "**/*.test.ts"]
}
