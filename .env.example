DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

REDIS_URL=rediss://default:PASSWORD@HOST:6379

# App / server
NODE_ENV=development
# Let Nx plugins take as long as they need to start, e.g. when several serve commands start at once
NX_PLUGIN_NO_TIMEOUTS=true
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200
API_PORT=3333
GATEWAY_PORT=3000
AUTH_PORT=3334
KAFKA_SERVICE_PORT=3335
CHAT_SERVICE_PORT=3336
LOGGER_SERVICE_PORT=3337
RECOMMENDATION_SERVICE_PORT=3338
# Browser origins allowed to open chat WebSockets (comma-separated)
CHAT_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400
# Optional: a stable name per chatting-service instance, so it keeps its Kafka delivery group across restarts
CHAT_INSTANCE_ID=
# Chat messages and file uploads each person may send per minute (counted in Redis when REDIS_URL is set)
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_UPLOAD_LIMIT_PER_MINUTE=10
# GIFs and stickers in chat (free key at https://developers.giphy.com)
GIPHY_API_KEY=
# Days logger-service keeps platform logs
LOG_RETENTION_DAYS=7
# Browser origins allowed to open the admin live logs WebSocket (comma-separated)
LOGS_ALLOWED_ORIGINS=http://localhost:4400
# Optional: a stable name per logger-service instance, so it keeps its live Kafka group across restarts
LOGGER_INSTANCE_ID=
API_URL=http://127.0.0.1:3333
# Linked from service request emails
USER_UI_URL=http://localhost:4200
SELLER_UI_URL=http://localhost:4300
ADMIN_UI_URL=http://localhost:4400
# Store links (product and shop pages) in seller-ui and admin-ui
NEXT_PUBLIC_SHOP_URL=http://localhost:4200

# Gmail SMTP (use an App Password, not your normal Gmail password)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_USER=
GMAIL_PASS=

# JWT secrets. All eight must be different, long random values, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SELLER_ACCESS_TOKEN_SECRET=
SELLER_REFRESH_TOKEN_SECRET=
RIDER_ACCESS_TOKEN_SECRET=
RIDER_REFRESH_TOKEN_SECRET=
ADMIN_ACCESS_TOKEN_SECRET=
ADMIN_REFRESH_TOKEN_SECRET=
RESET_PASSWORD_URL=http://localhost:3334/api/auth/reset-password

# ImageKit (product and chat photos). Private key: ImageKit dashboard > Developer options > API keys
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
