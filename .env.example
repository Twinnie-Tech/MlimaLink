DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

REDIS_URL=rediss://default:PASSWORD@HOST:6379

# App / server
NODE_ENV=development
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200
API_PORT=3333
GATEWAY_PORT=3000
AUTH_PORT=3334
API_URL=http://127.0.0.1:3333

# Gmail SMTP (use an App Password, not your normal Gmail password)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_USER=
GMAIL_PASS=

# JWT secrets. All four must be different, long random values, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SELLER_ACCESS_TOKEN_SECRET=
SELLER_REFRESH_TOKEN_SECRET=
RESET_PASSWORD_URL=http://localhost:3334/api/auth/reset-password
