// Prisma schema for MlimaLink (MongoDB)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model images {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  file_Id String
  url String
  userId String? @db.ObjectId @unique
  users users? @relation(fields: [userId], references: [id])
}

// Models will be added here (e.g. User for auth-service)
model users {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  password     String?
  role         String   @default("user")
  phone_number String?
  country      String?
  following    String[]
  avatar       images?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
