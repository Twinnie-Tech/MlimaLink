// Prisma schema for MlimaLink (MongoDB)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// An image belongs to one owner: a user or a shop.
/// userId and shopId are not @unique because MongoDB unique indexes allow only one
/// document with a missing value, which would cap shop images at one while user
/// images leave shopId empty (and the other way round).
model images {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  file_Id String
  url     String
  userId  String? @db.ObjectId
  users   users?  @relation(fields: [userId], references: [id])
  shopId  String? @db.ObjectId
  shops   shops?  @relation(fields: [shopId], references: [id])

  @@index([userId])
  @@index([shopId])
}

// Models will be added here (e.g. User for auth-service)
model users {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String         @unique
  password     String?
  role         String         @default("user")
  phone_number String?
  country      String?
  following    String[]
  /// At most one image; uploading a new avatar replaces the old one.
  avatar       images[]
  shop_reviews shop_reviews[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model sellers {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone_number String
  /// ISO 3166-1 alpha-2 code, e.g. "KE".
  country      String
  password     String
  /// Stripe Connect account id, set once the seller starts bank onboarding.
  stripeId     String?
  shop         shops?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Hours for one open day. Validated by parseOpeningHours in @org/models.
type opening_day {
  /// mon, tue, wed, thu, fri, sat or sun
  day   String
  /// 24-hour "HH:mm", e.g. "08:00"
  open  String
  /// 24-hour "HH:mm", later than open
  close String
}

/// A link to one of the shop's social media profiles.
type social_link {
  /// e.g. "facebook", "instagram", "x", "tiktok", "youtube", "whatsapp"
  platform String
  /// Full http(s) link to the profile
  url      String
}

/// One shop per seller. The link lives here (sellerId) because MongoDB unique
/// indexes treat a missing value as a duplicate, so an optional sellers.shopId
/// could only ever be empty for one seller.
model shops {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  bio           String?
  category      String
  address       String
  /// Open days only; an empty list means the seller hasn't set hours.
  opening_hours opening_day[]
  website       String?
  /// Wide header image shown at the top of the shop page (URL).
  coverBanner   String?
  socialLinks   social_link[]
  /// Average of the shop's review ratings; 0 until the first review.
  ratings       Float            @default(0)
  /// Optional; at most one image, and uploading a new avatar replaces the old one.
  avatar        images[]
  reviews       shop_reviews[]
  products      products[]
  discountCodes discount_codes[]
  sellerId      String           @unique @db.ObjectId
  seller        sellers          @relation(fields: [sellerId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// A shopper's review of a shop. One review per shopper per shop; posting again
/// should update the existing review.
model shop_reviews {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  /// 1 to 5
  rating    Float
  /// Optional written review
  reviews   String?
  shopId    String   @db.ObjectId
  shops     shops    @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shopId])
  @@index([shopId])
}

/// A value a shopper can pick for an option, e.g. "Black" or "42".
type product_option_value {
  label      String
  /// Hex colour shown as a swatch, e.g. "#111111". Colour options only.
  swatch     String?
  /// Index into products.images of the photo showing this value.
  imageIndex Int?
}

/// Something the shopper picks before buying, e.g. Colour or Size.
type product_option {
  name   String
  values product_option_value[]
}

/// A detail shown on the product page, e.g. Brand: Bata.
type product_spec {
  name  String
  value String
}

/// One combination of option values with its own stock.
type product_variant {
  sku     String?
  /// Option name → chosen value, e.g. { "Colour": "Black", "Size": "42" }.
  choices Json
  /// Overrides products.price for this combination.
  price   Float?
  stock   Int
}

/// A product listed by a shop. Checked by parseProductInput in @org/models, which also
/// requires exactly one variant per combination of option values.
model products {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  shortDescription String
  description      String
  category         String
  subCategory      String
  tags             String[]
  price            Float
  salePrice        Float?
  /// Cover photo first. Data URLs until image hosting is set up.
  images           String[]
  specs            product_spec[]
  options          product_option[]
  variants         product_variant[]
  /// Sum of the variants' stock, or the product's own stock when it has no options.
  stock            Int
  /// "full_upfront", "deposit" (half now, half on delivery) and/or "cash_on_delivery".
  /// Empty on older listings, which are treated as full payment upfront.
  paymentOptions   String[]
  ratings          Float             @default(0)
  reviewCount      Int               @default(0)
  shopId           String            @db.ObjectId
  shop             shops             @relation(fields: [shopId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([shopId])
  @@index([category, subCategory])
}

/// A code shoppers enter at checkout for money off one shop's products. Codes are
/// unique across the marketplace. Checked by parseDiscountCodeInput in @org/models.
model discount_codes {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Upper case letters and digits, e.g. "HARVEST10".
  code       String   @unique
  /// "percentage" or "fixed"
  type       String
  /// Percent off (1–90) or USD off.
  value      Float
  /// USD the shopper must spend on this shop's products first.
  minSpend   Float?
  usageLimit Int?
  usedCount  Int      @default(0)
  /// Last day the code works, "YYYY-MM-DD" (UTC).
  expiresAt  String?
  active     Boolean  @default(true)
  shopId     String   @db.ObjectId
  shop       shops    @relation(fields: [shopId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shopId])
}
