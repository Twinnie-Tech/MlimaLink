// Prisma schema for MlimaLink (MongoDB)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// An image belongs to one owner: a user or a shop.
/// userId and shopId are not @unique because MongoDB unique indexes allow only one
/// document with a missing value, which would cap shop images at one while user
/// images leave shopId empty (and the other way round).
model images {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  file_Id String
  url     String
  userId  String? @db.ObjectId
  users   users?  @relation(fields: [userId], references: [id])
  shopId  String? @db.ObjectId
  shops   shops?  @relation(fields: [shopId], references: [id])

  @@index([userId])
  @@index([shopId])
}

// Models will be added here (e.g. User for auth-service)
model users {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String            @unique
  password        String?
  role            String            @default("user")
  phone_number    String?
  country         String?
  following       String[]
  /// Set by an admin. A suspended shopper can't log in and their sessions stop working.
  suspended       Boolean           @default(false)
  /// At most one image; uploading a new avatar replaces the old one.
  avatar          images[]
  shop_reviews    shop_reviews[]
  product_reviews product_reviews[]
  conversations   conversations[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model sellers {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String          @unique
  phone_number  String
  /// ISO 3166-1 alpha-2 code, e.g. "KE".
  country       String
  password      String
  /// Stripe Connect account id, set once the seller starts bank onboarding.
  stripeId      String?
  /// Set by an admin. A suspended seller can't log in and their sessions stop working.
  suspended     Boolean         @default(false)
  shop          shops?
  conversations conversations[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Someone who runs MlimaLink. There is no sign-up: accounts are created with
/// `npm run admin:create`, and admins log in to admin-ui through auth-service.
model admins {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String    @unique
  password    String
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Hours for one open day. Validated by parseOpeningHours in @org/models.
type opening_day {
  /// mon, tue, wed, thu, fri, sat or sun
  day   String
  /// 24-hour "HH:mm", e.g. "08:00"
  open  String
  /// 24-hour "HH:mm", later than open
  close String
}

/// A link to one of the shop's social media profiles.
type social_link {
  /// e.g. "facebook", "instagram", "x", "tiktok", "youtube", "whatsapp"
  platform String
  /// Full http(s) link to the profile
  url      String
}

/// One shop per seller. The link lives here (sellerId) because MongoDB unique
/// indexes treat a missing value as a duplicate, so an optional sellers.shopId
/// could only ever be empty for one seller.
model shops {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  bio            String?
  category       String
  address        String
  /// Open days only; an empty list means the seller hasn't set hours.
  opening_hours  opening_day[]
  website        String?
  /// Wide header image shown at the top of the shop page (URL).
  coverBanner    String?
  socialLinks    social_link[]
  /// Average of the shop's review ratings; 0 until the first review.
  ratings        Float             @default(0)
  /// Optional; at most one image, and uploading a new avatar replaces the old one.
  avatar         images[]
  reviews        shop_reviews[]
  products       products[]
  discountCodes  discount_codes[]
  serviceProfile service_profiles?
  conversations  conversations[]
  /// Town riders collect orders from, one of DELIVERY_ZONES in @org/models.
  deliveryZone   String?
  /// USD charged to shoppers per order; DEFAULT_DELIVERY_FEE when unset.
  deliveryFee    Float?
  sellerId       String            @unique @db.ObjectId
  seller         sellers           @relation(fields: [sellerId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

/// A shopper's review of a shop. One review per shopper per shop; posting again
/// should update the existing review.
model shop_reviews {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  /// 1 to 5
  rating    Float
  /// Optional written review
  reviews   String?
  /// The shopper had a delivered order from this shop when they posted.
  verified  Boolean  @default(false)
  shopId    String   @db.ObjectId
  shops     shops    @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shopId])
  @@index([shopId])
}

/// A shopper's review of a product. One review per shopper per product; posting again
/// updates it, and products.ratings and reviewCount are recalculated. productId is a
/// plain id: deleting a product deletes its reviews in code.
model product_reviews {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      users    @relation(fields: [userId], references: [id])
  productId String   @db.ObjectId
  /// 1 to 5
  rating    Int
  comment   String?
  /// The shopper had a delivered order containing this product when they posted.
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

/// A value a shopper can pick for an option, e.g. "Black" or "42".
type product_option_value {
  label      String
  /// Hex colour shown as a swatch, e.g. "#111111". Colour options only.
  swatch     String?
  /// Index into products.images of the photo showing this value.
  imageIndex Int?
}

/// Something the shopper picks before buying, e.g. Colour or Size.
type product_option {
  name   String
  values product_option_value[]
}

/// A detail shown on the product page, e.g. Brand: Bata.
type product_spec {
  name  String
  value String
}

/// One combination of option values with its own stock.
type product_variant {
  sku     String?
  /// Option name → chosen value, e.g. { "Colour": "Black", "Size": "42" }.
  choices Json
  /// Overrides products.price for this combination.
  price   Float?
  stock   Int
}

/// A product listed by a shop. Checked by parseProductInput in @org/models, which also
/// requires exactly one variant per combination of option values.
model products {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  shortDescription String
  description      String
  category         String
  subCategory      String
  tags             String[]
  price            Float
  salePrice        Float?
  /// Cover photo first. ImageKit URLs; older listings may hold data URLs.
  images           String[]
  /// ImageKit file id of each photo, same order as images, for deleting them with
  /// the product. Empty for data URL photos.
  imageFileIds     String[]
  specs            product_spec[]
  options          product_option[]
  variants         product_variant[]
  /// Sum of the variants' stock, or the product's own stock when it has no options.
  stock            Int
  /// "full_upfront", "deposit" (half now, half on delivery) and/or "cash_on_delivery".
  /// Empty on older listings, which are treated as full payment upfront.
  paymentOptions   String[]
  ratings          Float             @default(0)
  reviewCount      Int               @default(0)
  shopId           String            @db.ObjectId
  shop             shops             @relation(fields: [shopId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([shopId])
  @@index([category, subCategory])
}

/// A code shoppers enter at checkout for money off one shop's products. Codes are
/// unique across the marketplace. Checked by parseDiscountCodeInput in @org/models.
model discount_codes {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Upper case letters and digits, e.g. "HARVEST10".
  code       String   @unique
  /// "percentage" or "fixed"
  type       String
  /// Percent off (1–90) or USD off.
  value      Float
  /// USD the shopper must spend on this shop's products first.
  minSpend   Float?
  usageLimit Int?
  usedCount  Int      @default(0)
  /// Last day the code works, "YYYY-MM-DD" (UTC).
  expiresAt  String?
  active     Boolean  @default(true)
  /// The shop products the code covers; empty means all of them.
  productIds String[] @db.ObjectId
  shopId     String   @db.ObjectId
  shop       shops    @relation(fields: [shopId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shopId])
}

/// A degree, licence or certificate on a provider's profile.
type qualification {
  title  String
  issuer String?
  year   Int?
}

/// How a shop presents itself as a service provider: skills, qualifications and past
/// work. One per shop. Checked by parseServiceProfileInput in @org/models.
model service_profiles {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  headline         String
  about            String
  skills           String[]
  yearsExperience  Int
  qualifications   qualification[]
  serviceArea      String
  /// Also takes work online.
  remote           Boolean         @default(false)
  /// ImageKit URLs of past work.
  portfolio        String[]
  /// ImageKit file id of each portfolio photo, same order as portfolio.
  portfolioFileIds String[]
  shopId           String          @unique @db.ObjectId
  shop             shops           @relation(fields: [shopId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

/// A shopper asking a provider for one of their services. The listing's title is copied
/// so the request still reads well if the listing is removed, which is why productId,
/// shopId and userId are plain ids rather than relations.
model service_requests {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @db.ObjectId
  serviceTitle String
  shopId       String   @db.ObjectId
  userId       String   @db.ObjectId
  clientName   String
  clientEmail  String
  clientPhone  String?
  details      String
  /// USD
  budget       Float?
  /// "YYYY-MM-DD"
  neededBy     String?
  /// "pending", "accepted", "declined" or "completed"
  status       String   @default("pending")
  /// The provider's reply, shown to the shopper.
  sellerNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId, createdAt])
  @@index([userId, createdAt])
}

/// Someone who delivers orders for shops. Signs up and logs in through auth-service
/// like sellers do; the delivery fields are filled in from the rider dashboard.
model riders {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  /// International format, e.g. "+254712345678".
  phone_number String
  password     String
  /// "motorbike", "bicycle", "car", "van" or "on_foot"; unset until the profile is filled in.
  vehicle      String?
  /// Towns the rider delivers in, from DELIVERY_ZONES in @org/models.
  zones        String[]
  /// Taking jobs right now.
  available    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([zones, available])
}

/// Where the shopper wants the order brought.
type delivery_address {
  recipientName String
  phone         String
  zone          String
  area          String
  street        String?
  notes         String?
}

/// A product in an order, copied at checkout so the order doesn't change with the listing.
type order_item {
  productId     String @db.ObjectId
  name          String
  imageUrl      String
  /// Option name → chosen value, e.g. { "Size": "42" }.
  choices       Json?
  quantity      Int
  unitPrice     Float
  total         Float
  discount      Float
  paymentOption String
}

/// One shop's part of a checkout. The shop name and prices are copied, so shopId and
/// userId are plain ids like service_requests.
model orders {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  /// Short reference shown to people, e.g. "ML-7Q2K9D".
  number         String           @unique
  shopId         String           @db.ObjectId
  shopName       String
  userId         String           @db.ObjectId
  buyerName      String
  buyerEmail     String
  address        delivery_address
  items          order_item[]
  subtotal       Float
  discount       Float
  discountCode   String?
  deliveryFee    Float
  total          Float
  /// Due when ordering, including the delivery fee.
  payNow         Float
  onDelivery     Float
  /// MlimaLink's cut of subtotal − discount at the rate when ordered. Unset on older
  /// orders, which use PLATFORM_FEE_RATE.
  platformFee    Float?
  /// subtotal − discount − platformFee: what the shop keeps.
  sellerEarnings Float?
  /// "placed", "confirmed", "out_for_delivery", "delivered" or "cancelled"
  status         String           @default("placed")
  /// Four digits the shopper gives the rider to prove the order arrived.
  deliveryCode   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([shopId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

type geo_point {
  lat Float
  lng Float
  at  DateTime
}

type delivery_event {
  /// The delivery status this event moved to.
  status String
  at     DateTime
  note   String?
  /// Where the rider was, when their phone shared it.
  lat    Float?
  lng    Float?
}

/// Getting one order from the shop to the shopper. One per order; asking for a rider
/// again after a decline or cancellation reuses it.
model deliveries {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String           @unique @db.ObjectId
  shopId          String           @db.ObjectId
  pickupZone      String
  dropoffZone     String
  /// USD paid to the rider: the delivery fee the shopper paid.
  fee             Float
  /// "open", "offered", "declined", "assigned", "picked_up", "delivered" or "cancelled"
  status          String
  /// The rider a seller picked, while waiting for their answer.
  offeredRiderId  String?          @db.ObjectId
  /// The rider doing the delivery, once someone accepts.
  riderId         String?          @db.ObjectId
  /// Wrong delivery codes entered since the last lock.
  codeAttempts    Int              @default(0)
  /// Set after too many wrong codes; no code is accepted until then.
  codeLockedUntil DateTime?
  lastLocation    geo_point?
  events          delivery_event[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, pickupZone])
  @@index([riderId, updatedAt])
  @@index([offeredRiderId, status])
  @@index([shopId])
}

/// Something a shopper did with a product, from the user_events topic. Used for
/// recommendations.
type user_action {
  /// "product_view", "add_to_wishlist", "add_to_cart" or "purchase". Removing a product
  /// from the wishlist or cart deletes its matching add instead of being stored.
  action    String
  productId String   @db.ObjectId
  shopId    String?  @db.ObjectId
  at        DateTime
}

/// What a shopper has been doing, kept up to date by kafka-service from the user_events
/// topic. userId is a plain id like orders.userId.
model user_analytics {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @unique @db.ObjectId
  /// Oldest first; kafka-service keeps only the latest USER_ACTIONS_KEPT.
  actions      user_action[]
  wishlistAdds Int           @default(0)
  cartAdds     Int           @default(0)
  lastActiveAt DateTime
  /// Last known "mobile", "tablet" or "desktop"; kept until an event says otherwise.
  device       String?
  /// Last known location from the host's geo-IP headers; unset when running locally.
  country      String?
  city         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// How shoppers respond to one product, kept up to date by kafka-service from the
/// user_events topic. productId and shopId are plain ids so the numbers survive the
/// listing being removed.
model product_analytics {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @unique @db.ObjectId
  shopId       String?  @db.ObjectId
  views        Int      @default(0)
  /// Shoppers who have it in their cart now: adds minus removals.
  cartAdds     Int      @default(0)
  /// Shoppers who have it on their wishlist now: adds minus removals.
  wishlistAdds Int      @default(0)
  /// Order lines it has appeared in.
  purchases    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId])
}

/// Visits to a shop's page by signed-in shoppers, kept up to date by kafka-service from
/// the user_events topic.
model shop_analytics {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId        String   @unique @db.ObjectId
  totalVisits   Int      @default(0)
  lastVisitedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A chat in chatting-service. "shop" chats are between a shopper and a shop (its seller
/// replies); "support" chats are between a shopper or seller and MlimaLink's admins, any
/// of whom can reply; "direct" chats are between any two shoppers, sellers or admins.
model conversations {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  /// "shop:<shopId>:<userId>", "support:user:<userId>", "support:seller:<sellerId>" or
  /// "direct:<role>:<id>|<role>:<id>" (sorted). One chat per pair, and unique even though
  /// userId, sellerId and shopId are optional.
  key             String          @unique
  /// "shop", "support" or "direct"
  kind            String
  /// Direct chats only: both people as "<role>:<id>", e.g. "seller:<sellerId>", sorted.
  participantKeys String[]
  userId          String?         @db.ObjectId
  user            users?          @relation(fields: [userId], references: [id])
  sellerId        String?         @db.ObjectId
  seller          sellers?        @relation(fields: [sellerId], references: [id])
  shopId          String?         @db.ObjectId
  shop            shops?          @relation(fields: [shopId], references: [id])
  /// Start of the latest message, for chat lists.
  lastMessage     String?
  lastMessageAt   DateTime?
  messages        chat_messages[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([kind, updatedAt])
  @@index([participantKeys, updatedAt])
}

/// One chat message. Written by chatting-service from the chat_messages topic; the id is
/// chosen when the message is sent, so a message Kafka delivers twice is stored once.
model chat_messages {
  id             String        @id @map("_id") @db.ObjectId
  conversationId String        @db.ObjectId
  conversation   conversations @relation(fields: [conversationId], references: [id])
  /// "user", "seller" or "admin"
  senderRole     String
  senderId       String        @db.ObjectId
  /// The sender's name when they sent it.
  senderName     String
  /// May be empty when the message is only photos, documents or a GIF.
  body           String
  /// Photo URLs the sender uploaded to their chat folder on ImageKit.
  attachments    String[]
  /// Documents the sender uploaded to their chat folder on ImageKit.
  files          chat_file[]
  /// A GIF or sticker from GIPHY; such a message has nothing else in it.
  gif            chat_gif?
  /// The message this one answers, as it read when quoted.
  replyTo        chat_reply?
  /// At most one per person.
  reactions      chat_reaction[]
  editedAt       DateTime?
  /// Set when the sender deleted it; the content is cleared then.
  deletedAt      DateTime?
  createdAt      DateTime

  @@index([conversationId, createdAt])
}

type chat_file {
  url      String
  /// The name it was shared with, e.g. "Invoice March.pdf".
  name     String
  /// Bytes.
  size     Int
  mimeType String
}

type chat_gif {
  /// "gif" or "sticker"
  kind   String
  url    String
  width  Int
  height Int
  title  String
}

type chat_reply {
  id         String
  senderName String
  /// What the quoted message said, shortened; "This message was deleted" once it is.
  preview    String
}

type chat_reaction {
  emoji String
  /// "<role>:<id>" of who reacted.
  key   String
  name  String
}

/// How far one person has read in a chat; unseen counts are worked out from it. Every
/// admin has their own row for a support chat.
model conversation_reads {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  /// "<role>:<id>", e.g. "admin:<adminId>"
  participant    String
  lastReadAt     DateTime

  @@unique([conversationId, participant])
  @@index([participant])
}

/// A log entry from the logs topic, stored by logger-service. Entries older than
/// LOG_RETENTION_DAYS are deleted.
model platform_logs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "debug", "info", "warn" or "error"
  level     String
  message   String
  /// The service that wrote it, e.g. "chatting-service".
  source    String
  meta      Json?
  timestamp DateTime

  @@index([timestamp])
  @@index([level, timestamp])
  @@index([source, timestamp])
}
