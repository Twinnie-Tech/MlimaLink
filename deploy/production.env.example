# Production settings for docker-compose.prod.yml.
# Copy to deploy/production.env on the server (it's gitignored) and fill in every value.
# Replace 203-0-113-7 with your server's public IP, dashes instead of dots, and the
# *.vercel.app names with your three Vercel project addresses.

NODE_ENV=production

# Caddy serves the gateway here over HTTPS. sslip.io needs no sign-up: it resolves
# api.203-0-113-7.sslip.io to 203.0.113.7.
API_DOMAIN=api.203-0-113-7.sslip.io

# MongoDB Atlas (allow the server's IP under Network Access)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mlimalink?retryWrites=true&w=majority

# Containers in docker-compose.prod.yml
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

# Where the UIs live: links in emails, and the only sites allowed to open WebSockets
USER_UI_URL=https://mlimalink-shop.vercel.app
SELLER_UI_URL=https://mlimalink-seller.vercel.app
ADMIN_UI_URL=https://mlimalink-admin.vercel.app
RESET_PASSWORD_URL=https://mlimalink-shop.vercel.app/api/auth/reset-password
CHAT_ALLOWED_ORIGINS=https://mlimalink-shop.vercel.app,https://mlimalink-seller.vercel.app,https://mlimalink-admin.vercel.app
LOGS_ALLOWED_ORIGINS=https://mlimalink-admin.vercel.app
CORS_ORIGIN=https://mlimalink-shop.vercel.app,https://mlimalink-seller.vercel.app,https://mlimalink-admin.vercel.app

# JWT secrets: eight different values, new for production. Generate each with
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SELLER_ACCESS_TOKEN_SECRET=
SELLER_REFRESH_TOKEN_SECRET=
RIDER_ACCESS_TOKEN_SECRET=
RIDER_REFRESH_TOKEN_SECRET=
ADMIN_ACCESS_TOKEN_SECRET=
ADMIN_REFRESH_TOKEN_SECRET=

# Gmail SMTP (an App Password, not your normal password)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_USER=
GMAIL_PASS=

# ImageKit (product and chat photos)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# GIFs and stickers in chat
GIPHY_API_KEY=

# Optional: seller payouts through Stripe Connect
STRIPE_SECRET_KEY=

CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_UPLOAD_LIMIT_PER_MINUTE=10
LOG_RETENTION_DAYS=7
